card_logs.json

# ─── Runtime data lists ───────────────────────────────────────
# These are YOUR operational data — proxy pool, site list, working proxies.
# Commit them only if you want them public (usually you don't).
proxy.txt
working_proxies.txt
premium.txt
sites.txt
site.txt

